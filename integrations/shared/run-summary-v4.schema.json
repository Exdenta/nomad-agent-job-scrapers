{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Exdenta/nomad-agent-job-scrapers/main/integrations/shared/run-summary-v4.schema.json",
  "title": "Nomad Agent public run summary v4",
  "description": "Minimal public outcome for one completed Actor run. Internal source diagnostics are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "startedAt",
    "finishedAt",
    "resultsLimited",
    "delivered",
    "retry"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nomad-agent-run-summary-v4"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "empty",
        "partial",
        "empty-limited"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resultsLimited": {
      "type": "boolean",
      "description": "True when the Actor knowingly stopped before processing all available candidates because of an item, billing, scan, or execution bound. False means no known result limit, not proof that the external source was exhausted."
    },
    "delivered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "retry": {
      "$ref": "#/$defs/retry"
    }
  },
  "$defs": {
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended",
        "afterSeconds"
      ],
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "afterSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3600
        }
      },
      "oneOf": [
        {
          "properties": {
            "recommended": {
              "const": false
            },
            "afterSeconds": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "recommended": {
              "const": true
            },
            "afterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "delivered": {
            "minimum": 1
          },
          "retry": {
            "properties": {
              "recommended": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "empty"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "delivered": {
            "const": 0
          },
          "resultsLimited": {
            "const": false
          },
          "retry": {
            "properties": {
              "recommended": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "delivered": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "empty-limited"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "delivered": {
            "const": 0
          },
          "resultsLimited": {
            "const": true
          },
          "retry": {
            "properties": {
              "recommended": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
