{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exdenta/open-job-scrapers/blob/main/integrations/shared/flat-job-v1.schema.json",
  "title": "Nomad Agent flat job integration record",
  "description": "A primitive-only projection of nomad-agent-job-v1 for tables and no-code integrations. The nested normalized record remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "nomad-agent-flat-job-v1"},
    "jobKey": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "identityExternalId": {"type": ["string", "null"]},
    "jobUrl": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "companyName": {"type": ["string", "null"]},
    "companySourceId": {"type": ["string", "null"]},
    "companyUrl": {"type": ["string", "null"]},
    "locationText": {"type": ["string", "null"]},
    "countryCode": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "workArrangements": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "workSchedules": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "contractTypes": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "postedAt": {"type": ["string", "null"]},
    "applicationDeadline": {"type": ["string", "null"]},
    "applicationUrl": {"type": ["string", "null"]},
    "applicationEmail": {"type": ["string", "null"]},
    "directApply": {"type": ["boolean", "null"]},
    "seniorityLevels": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "industries": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "jobFunctions": {"type": ["string", "null"], "description": "Compact JSON array string, or null."},
    "salaryCurrency": {"type": ["string", "null"]},
    "salaryExact": {"type": ["number", "null"]},
    "salaryMinimum": {"type": ["number", "null"]},
    "salaryMaximum": {"type": ["number", "null"]},
    "salaryPeriod": {"type": ["string", "null"]},
    "salaryRaw": {"type": ["string", "null"]},
    "descriptionText": {"type": ["string", "null"]},
    "llmStatus": {"enum": ["not_requested", "completed", "failed"]},
    "normalizedRecordJson": {"type": "string", "description": "Optional compact canonical record for destinations that can safely retain it."}
  },
  "required": [
    "schemaVersion",
    "jobKey",
    "source",
    "identityExternalId",
    "jobUrl",
    "title",
    "companyName",
    "companySourceId",
    "companyUrl",
    "locationText",
    "countryCode",
    "city",
    "region",
    "workArrangements",
    "workSchedules",
    "contractTypes",
    "postedAt",
    "applicationDeadline",
    "applicationUrl",
    "applicationEmail",
    "directApply",
    "seniorityLevels",
    "industries",
    "jobFunctions",
    "salaryCurrency",
    "salaryExact",
    "salaryMinimum",
    "salaryMaximum",
    "salaryPeriod",
    "salaryRaw",
    "descriptionText",
    "llmStatus"
  ]
}
