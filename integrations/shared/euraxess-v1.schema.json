{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Exdenta/OinkJobSearch/main/apify/job_custom_schemas/euraxess-v1.schema.json",
  "title": "EURAXESS nomad-agent-job-v1 extension",
  "description": "EURAXESS source fields that remain outside the common normalized contract, parsed deterministically from job detail pages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "academicLevelRaw",
    "researchInfrastructureStaffPosition",
    "unmappedJobInformation",
    "unparsedGeofields"
  ],
  "properties": {
    "academicLevelRaw": {
      "description": "Unmodified EURAXESS Positions / Academic Level taxonomy labels. These are source search classifications, not applicant education requirements.",
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "researchInfrastructureStaffPosition": {"type": ["string", "null"]},
    "unmappedJobInformation": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "unparsedGeofields": {
      "type": ["array", "null"],
      "items": {"$ref": "#/$defs/unparsedGeofield"}
    }
  },
  "$defs": {
    "unparsedGeofield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationIndex", "raw"],
      "properties": {
        "locationIndex": {"type": "integer", "minimum": 0},
        "raw": {"type": "string", "minLength": 1}
      }
    }
  }
}
