{
  "schemaVersion": "nomad-ai-job-fit-zapier-template-v1",
  "distribution": "editor-only",
  "trigger": {
    "app": "Schedule by Zapier",
    "event": "Every Day"
  },
  "actions": [
    {
      "step": 1,
      "app": "Apify",
      "event": "Run Actor",
      "actor": "job-atlas/ai-job-fit-scorer",
      "build": "latest",
      "input": {
        "mode": "search",
        "search": {
          "sources": [
            "linkedin",
            "remote_boards",
            "justjoinit"
          ],
          "keywords": [
            "data engineer",
            "analytics engineer"
          ],
          "postedWithinDays": 14,
          "maxItemsPerSource": 3,
          "cacheTtlSeconds": 1800,
          "concurrency": 3,
          "sourceTimeoutSecs": 120
        },
        "candidateProfile": {
          "primaryRole": "Data Engineer",
          "targetTerms": [
            "Data Engineer",
            "Analytics Engineer"
          ],
          "skills": [
            "Python",
            "SQL",
            "dbt"
          ],
          "seniorityLevels": [
            "mid"
          ],
          "remoteLocations": [
            "European Union"
          ],
          "hybridLocations": [],
          "onsiteLocations": [],
          "workArrangementPreferencesComplete": true
        },
        "maxItems": 5,
        "resultMode": "shortlist",
        "minDeliveryScore": 2,
        "minRankToForward": 30,
        "recoverHolds": false,
        "aiConcurrency": 2
      },
      "maxTotalChargeUsd": 0.1,
      "outputName": "startedRun",
      "waitForFinish": true
    },
    {
      "step": 2,
      "app": "Webhooks by Zapier",
      "event": "GET",
      "url": "https://api.apify.com/v2/actor-runs/{{1.startedRun.id}}",
      "authentication": "Apify bearer token from a private Zapier connection; never embed a credential in the specification",
      "responseRoot": "data",
      "outputName": "run",
      "requireBeforeNextStep": [
        "run.id == startedRun.id",
        "run.actId == OZ919PaAyAbifOdcL",
        "run.status == SUCCEEDED",
        "run.exitCode == 0",
        "run.buildId is nonempty",
        "run.buildNumber is a numeric immutable build number",
        "run.buildId == startedRun.buildId",
        "run.buildNumber == startedRun.buildNumber"
      ],
      "nonTerminalPolicy": "Stop without writing; configure Run Actor to wait for completion before this step."
    },
    {
      "step": 3,
      "app": "Webhooks by Zapier",
      "event": "GET",
      "url": "https://api.apify.com/v2/key-value-stores/{{2.run.defaultKeyValueStoreId}}/records/RUN-SUMMARY",
      "authentication": "Same private Apify bearer connection as step 2",
      "responseRoot": "body",
      "outputName": "summary"
    },
    {
      "step": 4,
      "app": "Apify",
      "event": "Get Dataset Items",
      "dataset": "{{2.run.defaultDatasetId}}",
      "limit": 5,
      "outputName": "row"
    },
    {
      "step": 5,
      "app": "Filter by Zapier",
      "event": "Continue if",
      "conditions": [
        "run.status == SUCCEEDED",
        "run.exitCode == 0",
        "row.schemaVersion == nomad-ai-job-fit-v1",
        "row.evaluationStatus == scored",
        "row.deliveryScore >= 2",
        "summary.actor.id == run.actId",
        "summary.actor.runId == run.id",
        "summary.actor.buildId == run.buildId",
        "summary.actor.buildNumber == run.buildNumber",
        "run.id == startedRun.id",
        "run.actId == OZ919PaAyAbifOdcL",
        "run.status == SUCCEEDED",
        "run.exitCode == 0",
        "run.buildId is nonempty",
        "run.buildNumber is a numeric immutable build number",
        "run.buildId == startedRun.buildId",
        "run.buildNumber == startedRun.buildNumber"
      ],
      "bindings": {
        "startedRun": "{{1.startedRun}}",
        "run": "{{2.run}}",
        "summary": "{{3.summary}}",
        "row": "{{4.row}}"
      }
    },
    {
      "step": 6,
      "app": "Google Sheets",
      "event": "Lookup Spreadsheet Row",
      "lookupColumn": "matchKey"
    },
    {
      "step": 7,
      "app": "Paths by Zapier",
      "event": "Update existing or create new row",
      "mappingColumns": [
        "schemaVersion",
        "matchKey",
        "evaluationKey",
        "jobKey",
        "candidateHash",
        "candidateSnapshotHash",
        "evaluatedAt",
        "fitScore",
        "deliveryScore",
        "recommendation",
        "evaluationStatus",
        "title",
        "company",
        "location",
        "url",
        "blockingGatesJson",
        "why",
        "gapSummary",
        "sourceRunId",
        "sourceBuild",
        "evaluationJson"
      ]
    }
  ],
  "requiredLiveTests": [
    "successful exact-build bundled-search Actor task",
    "terminal status, exact build, and per-source provenance inspected",
    "RUN-SUMMARY v3 legacy or v4 result policy, counts, single job-fit-result charge, and $0.25 owner-provider circuit breaker inspected manually because Zapier Apify action does not enforce the closed summary contract",
    "for v4 shortlist, every dataset row is scored and meets minDeliveryScore and chargedCount equals outputRows",
    "named Google Sheets row created",
    "same input rerun updates rather than duplicates",
    "partial-source and failed/ai_failed fixtures do not create unsafe writes"
  ],
  "publicationState": "not-created-in-Zapier-editor"
}
