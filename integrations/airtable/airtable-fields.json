{
  "schemaVersion": "nomad-agent-airtable-preset-v1",
  "tableName": "Jobs",
  "primaryField": "jobKey",
  "deduplication": {
    "field": "jobKey",
    "definition": "source:externalId",
    "match": "exact",
    "onOneMatch": "update",
    "onNoMatch": "create",
    "onMultipleMatches": "error"
  },
  "fields": [
    {"name": "schemaVersion", "type": "singleLineText", "required": true, "description": "Flat integration contract version."},
    {"name": "jobKey", "type": "singleLineText", "required": true, "description": "Primary field and stable source:externalId deduplication key."},
    {"name": "source", "type": "singleSelect", "required": true, "options": ["linkedin"], "description": "Source system slug."},
    {"name": "identityExternalId", "type": "singleLineText", "required": false, "description": "Source-native job identifier."},
    {"name": "jobUrl", "type": "url", "required": false, "description": "Canonical public job URL."},
    {"name": "title", "type": "singleLineText", "required": false, "description": "Job title."},
    {"name": "companyName", "type": "singleLineText", "required": false, "description": "Company name."},
    {"name": "companySourceId", "type": "singleLineText", "required": false, "description": "Source-native company identifier."},
    {"name": "companyUrl", "type": "url", "required": false, "description": "Public company URL."},
    {"name": "locationText", "type": "singleLineText", "required": false, "description": "Human-readable normalized location."},
    {"name": "countryCode", "type": "singleLineText", "required": false, "description": "ISO country code when known."},
    {"name": "city", "type": "singleLineText", "required": false, "description": "City when known."},
    {"name": "region", "type": "singleLineText", "required": false, "description": "Region or administrative area when known."},
    {"name": "workArrangements", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "workSchedules", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "contractTypes", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "postedAt", "type": "dateTime", "required": false, "description": "Source posting timestamp or date."},
    {"name": "applicationDeadline", "type": "date", "required": false, "description": "Application deadline when known."},
    {"name": "applicationUrl", "type": "url", "required": false, "description": "Direct application URL when known."},
    {"name": "applicationEmail", "type": "email", "required": false, "description": "Application email when explicitly supplied."},
    {"name": "directApply", "type": "checkbox", "required": false, "description": "Whether a direct application path is explicitly available."},
    {"name": "seniorityLevels", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "industries", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "jobFunctions", "type": "multilineText", "required": false, "description": "Compact JSON array string or null."},
    {"name": "salaryCurrency", "type": "singleLineText", "required": false, "description": "ISO currency code when known."},
    {"name": "salaryExact", "type": "number", "required": false, "description": "Exact salary amount when supplied."},
    {"name": "salaryMinimum", "type": "number", "required": false, "description": "Minimum salary amount when supplied."},
    {"name": "salaryMaximum", "type": "number", "required": false, "description": "Maximum salary amount when supplied."},
    {"name": "salaryPeriod", "type": "singleSelect", "required": false, "options": ["hour", "day", "week", "month", "year"], "description": "Salary period when known."},
    {"name": "salaryRaw", "type": "singleLineText", "required": false, "description": "Source salary text."},
    {"name": "descriptionText", "type": "multilineText", "required": false, "description": "Plain-text job description when included by the Actor."},
    {"name": "llmStatus", "type": "singleSelect", "required": true, "options": ["not_requested", "completed", "failed"], "description": "Optional AI enrichment status."}
  ]
}
