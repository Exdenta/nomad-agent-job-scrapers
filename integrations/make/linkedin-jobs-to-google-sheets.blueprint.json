{
  "name": "Find and upsert LinkedIn jobs to Google Sheets with Apify",
  "flow": [
    {
      "id": 1,
      "module": "util:BasicTrigger",
      "version": 1,
      "parameters": {
        "values": [
          {
            "spec": [
              { "name": "actorBuild", "value": "0.6.19" },
              { "name": "keyword", "value": "software engineer" },
              { "name": "location", "value": "United States" },
              { "name": "postedWithin", "value": "30d" },
              { "name": "workArrangementsJson", "value": "[]" },
              { "name": "maxItems", "value": "1" },
              { "name": "maxTotalChargeUsd", "value": "0.1" },
              { "name": "googleSpreadsheetId", "value": "REPLACE_WITH_GOOGLE_SPREADSHEET_ID" },
              { "name": "googleSheetName", "value": "Jobs" }
            ]
          }
        ]
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Configuration" },
        "notes": "Start with maxItems=1. Replace the spreadsheet ID and connect Apify and Google Sheets before running."
      }
    },
    {
      "id": 2,
      "module": "apify:runActorNew",
      "version": 1,
      "parameters": {},
      "mapper": {
        "actorId": "kqIdAA2UQiPdOtzEB",
        "runSync": true,
        "build": "{{1.actorBuild}}",
        "timeout": 120,
        "memory": 512,
        "maxItems": "{{1.maxItems}}",
        "maxTotalChargeUsd": "{{1.maxTotalChargeUsd}}",
        "actor_search_type": "user",
        "inputBodykqIdAA2UQiPdOtzEB": "{\n  \"schemaVersion\": \"nomad-agent-job-search-input-v1\",\n  \"keyword\": \"{{1.keyword}}\",\n  \"location\": \"{{1.location}}\",\n  \"postedWithin\": \"{{1.postedWithin}}\",\n  \"workArrangements\": {{1.workArrangementsJson}},\n  \"maxItems\": {{1.maxItems}},\n  \"translateToEnglish\": false,\n  \"aiEnrichment\": false,\n  \"includeRaw\": false,\n  \"dedupe\": { \"enabled\": false, \"key\": \"\", \"stateResetAcknowledged\": false },\n  \"analyticsEnabled\": false\n}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Run LinkedIn jobs Actor" },
        "notes": "Select your Apify connection. The public Actor ID is pinned and the first run is bounded to one item."
      }
    },
    {
      "id": 3,
      "module": "apify:fetchDatasetItems",
      "version": 1,
      "parameters": {},
      "mapper": {
        "type": "clean",
        "limit": "{{1.maxItems}}",
        "format": "json",
        "datasetId": "{{2.defaultDatasetId}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "Get normalized jobs" },
        "notes": "Use the same Apify connection as the Actor module. Each dataset item becomes one bundle."
      }
    },
    {
      "id": 4,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "input": [
          { "name": "job", "value": "{{`3`}}" }
        ],
        "codeEditorJavascript": "const job = input.job;\nconst roots = ['schemaVersion', 'identity', 'data', 'custom', 'llm', 'raw'];\nif (!job || typeof job !== 'object') throw new Error('Actor item must be an object.');\nconst actualRoots = Object.keys(job).sort();\nconst expectedRoots = [...roots].sort();\nif (JSON.stringify(actualRoots) !== JSON.stringify(expectedRoots)) throw new Error('Actor item has unexpected roots: ' + actualRoots.join(', '));\nif (job.schemaVersion !== 'nomad-agent-job-v1') throw new Error('Expected nomad-agent-job-v1.');\nconst identity = job.identity || {};\nif (!identity.source || identity.externalId == null) throw new Error('identity.source and identity.externalId are required.');\nconst data = job.data || {};\nconst company = data.company || {};\nconst classification = data.classification || {};\nconst location = Array.isArray(data.locations) && data.locations.length ? data.locations[0] : {};\nconst employment = data.employment || {};\nconst application = data.application || {};\nconst seniority = data.seniority || {};\nconst compensation = data.compensation || {};\nconst compact = value => value == null ? null : JSON.stringify(value);\nreturn {\n  schemaVersion: 'nomad-agent-flat-job-v1',\n  jobKey: String(identity.source) + ':' + String(identity.externalId),\n  source: String(identity.source),\n  identityExternalId: String(identity.externalId),\n  jobUrl: identity.url ?? null,\n  title: data.title ?? null,\n  companyName: company.name ?? null,\n  companySourceId: company.sourceId ?? null,\n  companyUrl: company.url ?? null,\n  locationText: location.raw ?? null,\n  countryCode: location.countryCode ?? null,\n  city: location.city ?? null,\n  region: location.region ?? null,\n  workArrangements: compact(employment.workArrangements),\n  workSchedules: compact(employment.workSchedules),\n  contractTypes: compact(employment.contractTypes),\n  postedAt: application.postedAt ?? null,\n  applicationDeadline: application.deadline ?? null,\n  applicationUrl: application.url ?? null,\n  applicationEmail: application.email ?? null,\n  directApply: application.directApply ?? null,\n  seniorityLevels: compact(seniority.levels),\n  industries: compact(classification.industries),\n  jobFunctions: compact(classification.jobFunctions),\n  salaryCurrency: compensation.currency ?? null,\n  salaryExact: compensation.exact ?? null,\n  salaryMinimum: compensation.minimum ?? null,\n  salaryMaximum: compensation.maximum ?? null,\n  salaryPeriod: compensation.period ?? null,\n  salaryRaw: compensation.raw ?? null,\n  descriptionText: data.descriptionText ?? null,\n  llmStatus: job.llm && job.llm.status != null ? job.llm.status : null\n};"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Validate and flatten job" },
        "notes": "Validates the six-root canonical contract and creates the 32-column nomad-agent-flat-job-v1 projection."
      }
    },
    {
      "id": 5,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "limit": "1",
        "continue": true,
        "filter": [
          [
            { "a": "B", "b": "{{4.result.jobKey}}", "o": "text:equal" }
          ]
        ],
        "sheetId": "{{1.googleSheetName}}",
        "sortOrder": "asc",
        "spreadsheetId": "{{1.googleSpreadsheetId}}",
        "tableFirstRow": "A1:AF1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0, "name": "Find row by jobKey" },
        "notes": "Select your Google Sheets connection. Keep Continue execution when no results enabled so new jobs reach the Add Row branch."
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": { "x": 1500, "y": 150, "name": "Update or append" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 7,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Existing jobKey",
                "conditions": [[{ "a": "{{5.__ROW_NUMBER__}}", "o": "exist" }]]
              },
              "mapper": {
                "mode": "map",
                "spreadsheetId": "{{1.googleSpreadsheetId}}",
                "sheetId": "{{1.googleSheetName}}",
                "rowNumber": "{{5.__ROW_NUMBER__}}",
                "tableFirstRow": "A1:AF1",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "0": "{{4.result.schemaVersion}}",
                  "1": "{{4.result.jobKey}}",
                  "2": "{{4.result.source}}",
                  "3": "{{4.result.identityExternalId}}",
                  "4": "{{4.result.jobUrl}}",
                  "5": "{{4.result.title}}",
                  "6": "{{4.result.companyName}}",
                  "7": "{{4.result.companySourceId}}",
                  "8": "{{4.result.companyUrl}}",
                  "9": "{{4.result.locationText}}",
                  "10": "{{4.result.countryCode}}",
                  "11": "{{4.result.city}}",
                  "12": "{{4.result.region}}",
                  "13": "{{4.result.workArrangements}}",
                  "14": "{{4.result.workSchedules}}",
                  "15": "{{4.result.contractTypes}}",
                  "16": "{{4.result.postedAt}}",
                  "17": "{{4.result.applicationDeadline}}",
                  "18": "{{4.result.applicationUrl}}",
                  "19": "{{4.result.applicationEmail}}",
                  "20": "{{4.result.directApply}}",
                  "21": "{{4.result.seniorityLevels}}",
                  "22": "{{4.result.industries}}",
                  "23": "{{4.result.jobFunctions}}",
                  "24": "{{4.result.salaryCurrency}}",
                  "25": "{{4.result.salaryExact}}",
                  "26": "{{4.result.salaryMinimum}}",
                  "27": "{{4.result.salaryMaximum}}",
                  "28": "{{4.result.salaryPeriod}}",
                  "29": "{{4.result.salaryRaw}}",
                  "30": "{{4.result.descriptionText}}",
                  "31": "{{4.result.llmStatus}}"
                }
              },
              "metadata": {
                "designer": { "x": 1800, "y": 0, "name": "Update existing job" },
                "notes": "Refresh the existing row matched by jobKey."
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "New jobKey",
                "conditions": [[{ "a": "{{5.__ROW_NUMBER__}}", "o": "notexist" }]]
              },
              "mapper": {
                "mode": "map",
                "from": "drive",
                "spreadsheetId": "{{1.googleSpreadsheetId}}",
                "sheetId": "{{1.googleSheetName}}",
                "includesHeaders": true,
                "insertUnformatted": false,
                "insertDataOption": "INSERT_ROWS",
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "0": "{{4.result.schemaVersion}}",
                  "1": "{{4.result.jobKey}}",
                  "2": "{{4.result.source}}",
                  "3": "{{4.result.identityExternalId}}",
                  "4": "{{4.result.jobUrl}}",
                  "5": "{{4.result.title}}",
                  "6": "{{4.result.companyName}}",
                  "7": "{{4.result.companySourceId}}",
                  "8": "{{4.result.companyUrl}}",
                  "9": "{{4.result.locationText}}",
                  "10": "{{4.result.countryCode}}",
                  "11": "{{4.result.city}}",
                  "12": "{{4.result.region}}",
                  "13": "{{4.result.workArrangements}}",
                  "14": "{{4.result.workSchedules}}",
                  "15": "{{4.result.contractTypes}}",
                  "16": "{{4.result.postedAt}}",
                  "17": "{{4.result.applicationDeadline}}",
                  "18": "{{4.result.applicationUrl}}",
                  "19": "{{4.result.applicationEmail}}",
                  "20": "{{4.result.directApply}}",
                  "21": "{{4.result.seniorityLevels}}",
                  "22": "{{4.result.industries}}",
                  "23": "{{4.result.jobFunctions}}",
                  "24": "{{4.result.salaryCurrency}}",
                  "25": "{{4.result.salaryExact}}",
                  "26": "{{4.result.salaryMinimum}}",
                  "27": "{{4.result.salaryMaximum}}",
                  "28": "{{4.result.salaryPeriod}}",
                  "29": "{{4.result.salaryRaw}}",
                  "30": "{{4.result.descriptionText}}",
                  "31": "{{4.result.llmStatus}}"
                }
              },
              "metadata": {
                "designer": { "x": 1800, "y": 300, "name": "Append new job" },
                "notes": "Append only when no row with this jobKey exists."
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
