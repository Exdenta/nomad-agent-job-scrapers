{
  "name": "Find and upsert LinkedIn jobs to Google Sheets with Apify",
  "flow": [
    {
      "id": 1,
      "module": "apify:finishedTaskRun",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch completed LinkedIn Task runs"
        },
        "notes": "Select the Apify Task pinned to exact LinkedIn build 0.6.38. Only terminal successful runs are delivered; this scenario never starts another Actor run."
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "maxitems",
            "value": "1"
          },
          {
            "name": "actorbuild",
            "value": "0.6.38"
          },
          {
            "name": "googlespreadsheetid",
            "value": "REPLACE_WITH_GOOGLE_SPREADSHEET_ID"
          },
          {
            "name": "googlesheetname",
            "value": "Jobs"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Configuration"
        },
        "notes": "Replace the spreadsheet ID. Select the Task pinned to exact build 0.6.38 in the trigger. Keep maxitems small for the first destination smoke test."
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "{{1.output.runSummary}}",
        "gzip": true,
        "method": "get",
        "headers": [],
        "timeout": "40",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Read factual RUN-SUMMARY"
        },
        "notes": "Reads the Actor output schema's signed runSummary link for the original run. Missing or malformed status stops the scenario; it never authorizes a retry."
      },
      "filter": {
        "name": "Read status only for the exact successful Actor build",
        "conditions": [
          [
            {
              "a": "{{1.status}}",
              "b": "SUCCEEDED",
              "o": "text:equal"
            },
            {
              "a": "{{1.buildNumber}}",
              "b": "{{2.actorbuild}}",
              "o": "text:equal"
            },
            {
              "a": "{{1.output.runSummary}}",
              "o": "exist"
            }
          ]
        ]
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 150,
          "name": "Validate terminal run and deliver"
        },
        "notes": "Deliver only when the original run is terminal SUCCEEDED, its factual fleet-v2 RUN-SUMMARY is succeeded or empty, and the exact configured build matches. The scenario performs no automatic paid retry."
      },
      "routes": [
        {
          "flow": [
            {
              "id": 8,
              "module": "apify:fetchDatasetItems",
              "version": 1,
              "parameters": {},
              "mapper": {
                "type": "clean",
                "limit": "{{2.maxitems}}",
                "format": "json",
                "datasetId": "{{1.defaultDatasetId}}"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 150,
                  "name": "Get normalized jobs"
                },
                "notes": "Fetches the completed run default dataset only after factual RUN-SUMMARY validation. An empty status means no matching jobs; all degraded or invalid statuses stop without an automatic retry."
              },
              "filter": {
                "name": "Deliver only a valid factual run status",
                "conditions": [
                  [
                    {
                      "a": "{{3.data.schemaVersion}}",
                      "b": "nomad-agent-fleet-run-summary-v2",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{3.data.status}}",
                      "b": "succeeded",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{3.data.sources.linkedin.status}}",
                      "b": "succeeded",
                      "o": "text:equal"
                    }
                  ],
                  [
                    {
                      "a": "{{3.data.schemaVersion}}",
                      "b": "nomad-agent-fleet-run-summary-v2",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{3.data.status}}",
                      "b": "empty",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{3.data.sources.linkedin.status}}",
                      "b": "empty",
                      "o": "text:equal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 9,
              "module": "util:SetVariables",
              "version": 1,
              "parameters": {},
              "filter": {
                "name": "Skip empty Actor runs",
                "conditions": [
                  [
                    {
                      "a": "{{8.identity.source}}",
                      "o": "exist"
                    },
                    {
                      "a": "{{8.identity.externalId}}",
                      "o": "exist"
                    }
                  ]
                ]
              },
              "mapper": {
                "variables": [
                  {
                    "name": "schemaVersion",
                    "value": "nomad-agent-flat-job-v1"
                  },
                  {
                    "name": "jobKey",
                    "value": "{{8.identity.source}}:{{8.identity.externalId}}"
                  },
                  {
                    "name": "source",
                    "value": "{{8.identity.source}}"
                  },
                  {
                    "name": "identityExternalId",
                    "value": "{{8.identity.externalId}}"
                  },
                  {
                    "name": "jobUrl",
                    "value": "{{8.identity.url}}"
                  },
                  {
                    "name": "title",
                    "value": "{{8.data.title}}"
                  },
                  {
                    "name": "companyName",
                    "value": "{{8.data.company.name}}"
                  },
                  {
                    "name": "companySourceId",
                    "value": "{{8.data.company.sourceId}}"
                  },
                  {
                    "name": "companyUrl",
                    "value": "{{8.data.company.url}}"
                  },
                  {
                    "name": "locationText",
                    "value": "{{get(first(8.data.locations); \"raw\")}}"
                  },
                  {
                    "name": "countryCode",
                    "value": "{{get(first(8.data.locations); \"countryCode\")}}"
                  },
                  {
                    "name": "city",
                    "value": "{{get(first(8.data.locations); \"city\")}}"
                  },
                  {
                    "name": "region",
                    "value": "{{get(first(8.data.locations); \"region\")}}"
                  },
                  {
                    "name": "workArrangements",
                    "value": "{{if(8.data.employment.workArrangements = null; null; if(length(8.data.employment.workArrangements) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.employment.workArrangements; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "workSchedules",
                    "value": "{{if(8.data.employment.workSchedules = null; null; if(length(8.data.employment.workSchedules) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.employment.workSchedules; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "contractTypes",
                    "value": "{{if(8.data.employment.contractTypes = null; null; if(length(8.data.employment.contractTypes) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.employment.contractTypes; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "postedAt",
                    "value": "{{8.data.application.postedAt}}"
                  },
                  {
                    "name": "applicationDeadline",
                    "value": "{{8.data.application.deadline}}"
                  },
                  {
                    "name": "applicationUrl",
                    "value": "{{8.data.application.url}}"
                  },
                  {
                    "name": "applicationEmail",
                    "value": "{{8.data.application.email}}"
                  },
                  {
                    "name": "directApply",
                    "value": "{{8.data.application.directApply}}"
                  },
                  {
                    "name": "seniorityLevels",
                    "value": "{{if(8.data.seniority.levels = null; null; if(length(8.data.seniority.levels) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.seniority.levels; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "industries",
                    "value": "{{if(8.data.classification.industries = null; null; if(length(8.data.classification.industries) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.classification.industries; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "jobFunctions",
                    "value": "{{if(8.data.classification.jobFunctions = null; null; if(length(8.data.classification.jobFunctions) = 0; \"[]\"; join(add(emptyarray; \"[\\\"\"; join(8.data.classification.jobFunctions; \"\\\",\\\"\"); \"\\\"]\"); emptystring)))}}"
                  },
                  {
                    "name": "salaryCurrency",
                    "value": "{{8.data.compensation.currency}}"
                  },
                  {
                    "name": "salaryExact",
                    "value": "{{8.data.compensation.exact}}"
                  },
                  {
                    "name": "salaryMinimum",
                    "value": "{{8.data.compensation.minimum}}"
                  },
                  {
                    "name": "salaryMaximum",
                    "value": "{{8.data.compensation.maximum}}"
                  },
                  {
                    "name": "salaryPeriod",
                    "value": "{{8.data.compensation.period}}"
                  },
                  {
                    "name": "salaryRaw",
                    "value": "{{8.data.compensation.raw}}"
                  },
                  {
                    "name": "descriptionText",
                    "value": "{{8.raw.description}}"
                  },
                  {
                    "name": "llmStatus",
                    "value": "{{ifempty(8.llm.status; \"not_requested\")}}"
                  }
                ],
                "scope": "roundtrip"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 150,
                  "name": "Flatten normalized job"
                },
                "notes": "Creates the 32-column nomad-agent-flat-job-v1 projection with Make's free built-in Tools module. No paid Make Code app is required."
              }
            },
            {
              "id": 10,
              "module": "google-sheets:filterRows",
              "version": 2,
              "parameters": {},
              "mapper": {
                "from": "drive",
                "limit": "1",
                "continue": true,
                "filter": [
                  [
                    {
                      "a": "B",
                      "b": "{{9.jobKey}}",
                      "o": "text:equal"
                    }
                  ]
                ],
                "sheetId": "{{2.googlesheetname}}",
                "sortOrder": "asc",
                "spreadsheetId": "{{2.googlespreadsheetid}}",
                "tableFirstRow": "A1:AF1",
                "includesHeaders": true,
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 150,
                  "name": "Find row by jobKey"
                },
                "notes": "Select your Google Sheets connection. Keep Continue execution when no results enabled so new jobs reach the Add Row branch."
              }
            },
            {
              "id": 11,
              "module": "builtin:BasicRouter",
              "version": 1,
              "parameters": {},
              "mapper": null,
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": 300,
                  "name": "Update or append"
                }
              },
              "routes": [
                {
                  "flow": [
                    {
                      "id": 12,
                      "module": "google-sheets:updateRow",
                      "version": 2,
                      "parameters": {},
                      "filter": {
                        "name": "Existing jobKey",
                        "conditions": [
                          [
                            {
                              "a": "{{10.__ROW_NUMBER__}}",
                              "o": "exist"
                            }
                          ]
                        ]
                      },
                      "mapper": {
                        "mode": "map",
                        "spreadsheetId": "{{2.googlespreadsheetid}}",
                        "sheetId": "{{2.googlesheetname}}",
                        "rowNumber": "{{10.__ROW_NUMBER__}}",
                        "tableFirstRow": "A1:AF1",
                        "includesHeaders": true,
                        "useColumnHeaders": false,
                        "valueInputOption": "USER_ENTERED",
                        "values": {
                          "0": "{{9.schemaVersion}}",
                          "1": "{{9.jobKey}}",
                          "2": "{{9.source}}",
                          "3": "{{9.identityExternalId}}",
                          "4": "{{9.jobUrl}}",
                          "5": "{{9.title}}",
                          "6": "{{9.companyName}}",
                          "7": "{{9.companySourceId}}",
                          "8": "{{9.companyUrl}}",
                          "9": "{{9.locationText}}",
                          "10": "{{9.countryCode}}",
                          "11": "{{9.city}}",
                          "12": "{{9.region}}",
                          "13": "{{9.workArrangements}}",
                          "14": "{{9.workSchedules}}",
                          "15": "{{9.contractTypes}}",
                          "16": "{{9.postedAt}}",
                          "17": "{{9.applicationDeadline}}",
                          "18": "{{9.applicationUrl}}",
                          "19": "{{9.applicationEmail}}",
                          "20": "{{9.directApply}}",
                          "21": "{{9.seniorityLevels}}",
                          "22": "{{9.industries}}",
                          "23": "{{9.jobFunctions}}",
                          "24": "{{9.salaryCurrency}}",
                          "25": "{{9.salaryExact}}",
                          "26": "{{9.salaryMinimum}}",
                          "27": "{{9.salaryMaximum}}",
                          "28": "{{9.salaryPeriod}}",
                          "29": "{{9.salaryRaw}}",
                          "30": "{{9.descriptionText}}",
                          "31": "{{9.llmStatus}}"
                        }
                      },
                      "metadata": {
                        "designer": {
                          "x": 2400,
                          "y": 0,
                          "name": "Update existing job"
                        },
                        "notes": "Refresh the existing row matched by jobKey."
                      }
                    }
                  ]
                },
                {
                  "flow": [
                    {
                      "id": 13,
                      "module": "google-sheets:addRow",
                      "version": 2,
                      "parameters": {},
                      "filter": {
                        "name": "New jobKey",
                        "conditions": [
                          [
                            {
                              "a": "{{10.__ROW_NUMBER__}}",
                              "o": "notexist"
                            }
                          ]
                        ]
                      },
                      "mapper": {
                        "mode": "map",
                        "from": "drive",
                        "spreadsheetId": "{{2.googlespreadsheetid}}",
                        "sheetId": "{{2.googlesheetname}}",
                        "includesHeaders": true,
                        "insertUnformatted": false,
                        "insertDataOption": "INSERT_ROWS",
                        "valueInputOption": "USER_ENTERED",
                        "values": {
                          "0": "{{9.schemaVersion}}",
                          "1": "{{9.jobKey}}",
                          "2": "{{9.source}}",
                          "3": "{{9.identityExternalId}}",
                          "4": "{{9.jobUrl}}",
                          "5": "{{9.title}}",
                          "6": "{{9.companyName}}",
                          "7": "{{9.companySourceId}}",
                          "8": "{{9.companyUrl}}",
                          "9": "{{9.locationText}}",
                          "10": "{{9.countryCode}}",
                          "11": "{{9.city}}",
                          "12": "{{9.region}}",
                          "13": "{{9.workArrangements}}",
                          "14": "{{9.workSchedules}}",
                          "15": "{{9.contractTypes}}",
                          "16": "{{9.postedAt}}",
                          "17": "{{9.applicationDeadline}}",
                          "18": "{{9.applicationUrl}}",
                          "19": "{{9.applicationEmail}}",
                          "20": "{{9.directApply}}",
                          "21": "{{9.seniorityLevels}}",
                          "22": "{{9.industries}}",
                          "23": "{{9.jobFunctions}}",
                          "24": "{{9.salaryCurrency}}",
                          "25": "{{9.salaryExact}}",
                          "26": "{{9.salaryMinimum}}",
                          "27": "{{9.salaryMaximum}}",
                          "28": "{{9.salaryPeriod}}",
                          "29": "{{9.salaryRaw}}",
                          "30": "{{9.descriptionText}}",
                          "31": "{{9.llmStatus}}"
                        }
                      },
                      "metadata": {
                        "designer": {
                          "x": 2400,
                          "y": 300,
                          "name": "Append new job"
                        },
                        "notes": "Append only when no row with this jobKey exists."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com"
  }
}
